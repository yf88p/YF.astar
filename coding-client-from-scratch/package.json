{
  "name": "kiln-coding-client",
  "version": "0.1.0",
  "description": "A deliberate, local-first coding workbench for your terminal",
  "type": "module",
  "bin": { "kiln": "dist/src/cli.js" },
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "verify": "npm run check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "blessed": "^0.1.81",
    "diff": "^8.0.2",
    "ignore": "^7.0.5",
    "minimatch": "^10.0.3"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "files": ["dist/src", "examples", "docs", "README.md", "LICENSE"],
  "license": "MIT"
}
