# Local editor: copy this file to .env.development at the repository root.
# Package builds also read .env.production directly: copy this file there and
# change MODE to production. Never commit populated environment files.
# VITE_* values are shipped to the browser; never put server secrets here.
MODE=development
VITE_APP_PORT=3000
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DISABLE_SENTRY=true
VITE_APP_ENABLE_ESLINT=false
VITE_APP_ENABLE_PWA=false
VITE_APP_COLLAPSE_OVERLAY=true
VITE_APP_DEV_DISABLE_LIVE_RELOAD=false
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
FAST_REFRESH=true

# Public upstream navigation URLs (not private deployment configuration).
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

# Optional network features require services you configure and operate.
# These reserved .invalid URLs are placeholders, not working backends.
# Scene sharing (GET URL needs the trailing slash):
VITE_APP_BACKEND_V2_GET_URL=https://your-scene-backend.invalid/api/v2/scenes/
VITE_APP_BACKEND_V2_POST_URL=https://your-scene-backend.invalid/api/v2/scenes/
# Collaboration WebSocket service:
VITE_APP_WS_SERVER_URL=https://your-collaboration-server.invalid
# Library publishing and AI features:
VITE_APP_LIBRARY_BACKEND=https://your-library-backend.invalid
VITE_APP_AI_BACKEND=https://your-ai-backend.invalid

# Collaboration persistence and image sharing require your Firebase project's
# browser configuration. Replace {} with one single-line JSON object containing
# apiKey, authDomain, projectId, storageBucket, messagingSenderId, appId, and
# databaseURL if applicable. Apply the Firebase rules to YOUR project using an
# explicit --project argument, not the upstream .firebaserc default.
VITE_APP_FIREBASE_CONFIG={}

# Optional Excalidraw Plus iframe export: provide its matching PUBLIC JWT
# verification key only. No private signing key belongs in browser configuration.
VITE_APP_PLUS_EXPORT_PUBLIC_KEY=
