{
  "name": "newton-physics-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "npm install --no-audit --no-fund && vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
