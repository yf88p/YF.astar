    "test:browser": "tsx tests/browser.ts",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "@playwright/test": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
